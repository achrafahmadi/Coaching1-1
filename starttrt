<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --bg:#141414;--panel:#1a1a1a;--ink:#f0f0f0;--muted:#b8b8b8;--gold:#C9A84C;--gold2:#e2c06a;--gold3:#8a6d2a;--gold-ink:#141414;--line:rgba(255,255,255,.11);--tick:#2a2a2a;color-scheme:dark;
  --display:'Cairo','Tahoma',sans-serif;
  --body:'Cairo','Tahoma',system-ui,sans-serif;
}
html{color-scheme:dark;scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 var(--body)}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}
a{color:inherit}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
header{border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;padding:18px 0}
.brand{font:900 24px var(--display);text-decoration:none}
nav a{margin-inline-start:20px;text-decoration:none;color:var(--muted);font-weight:500;font-size:15px}
nav a:hover{color:var(--gold)}
h1,h2,h3{font-family:var(--display);line-height:1.25;margin:0;font-weight:900}
h1{font-size:clamp(40px,10vw,92px);line-height:1.15}
h2{font-size:clamp(36px,6vw,60px);margin-bottom:12px}
h3{font-size:30px}
.lead{color:var(--muted);max-width:56ch;font-size:19px}
.btn{display:inline-block;background:var(--gold);color:var(--gold-ink);font-weight:700;padding:14px 26px;border-radius:6px;text-decoration:none;border:0;cursor:pointer;font:700 16px var(--body)}
.btn.ghost{background:transparent;color:var(--ink);border:2px solid var(--line)}
.btn:hover{filter:brightness(1.08)}
.hero{padding:40px 0 30px}
.hero .lead{margin:22px 0 28px}
.hero .cta{display:flex;gap:12px;flex-wrap:wrap}
/* day ruler: the signature element */
.ruler{margin-top:44px;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:22px 20px}
.ruler-top{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:18px}
.toggle{display:flex;gap:8px}
.toggle button{font:700 15px var(--body);padding:9px 18px;border-radius:6px;border:2px solid var(--line);background:transparent;color:var(--ink);cursor:pointer}
.toggle button[aria-pressed="true"]{background:var(--gold);color:var(--gold-ink);border-color:var(--gold)}
#rlabel{font:700 22px var(--display)}
.ticks{display:grid;grid-template-columns:repeat(90,1fr);gap:2px;height:56px;align-items:end}
.ticks i{display:block;background:var(--tick);height:40%;border-radius:1px;transition:background .25s,height .25s}
.ticks i.on{background:var(--gold);height:70%}
.ticks i.mark{height:100%}
.marks{display:flex;justify-content:space-between;color:var(--muted);font-size:13px;margin-top:8px}
section{padding:64px 0}
.offers{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));margin-top:32px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:30px;display:flex;flex-direction:column}
.card.sel{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold)}
.card .days{font:900 96px/1 var(--display);color:var(--gold)}
.card p{color:var(--muted);margin:10px 0 18px}
.card ul{padding-inline-start:20px;margin:0 0 24px}
.card li{margin-bottom:8px}
.card .btn{margin-top:auto;text-align:center}
.tag{font-weight:700;font-size:14px;color:var(--muted)}
.pillars{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));margin-top:28px}
.pillars div{border-top:3px solid var(--gold);padding-top:14px}
.pillars p{color:var(--muted);margin:8px 0 0}
.phases{margin-top:28px;display:grid;gap:0;border-inline-start:3px solid var(--line);padding-inline-start:24px}
.phase{padding:0 0 28px;position:relative}
.phase::before{content:"";position:absolute;inset-inline-start:-33px;top:8px;width:15px;height:15px;border-radius:50%;background:var(--gold)}
.phase b{font:900 24px var(--display);display:block}
.phase span{color:var(--muted)}
.results{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));margin-top:28px}
.ph{border:2px dashed var(--line);border-radius:10px;min-height:200px;display:flex;align-items:center;justify-content:center;text-align:center;padding:20px;color:var(--muted);font-size:15px}
details{border-bottom:1px solid var(--line);padding:16px 0}
summary{cursor:pointer;font-weight:700;font-size:18px}
details p{color:var(--muted);margin:10px 0 0}
form{display:grid;gap:14px;max-width:520px;margin-top:24px}
label{display:grid;gap:6px;font-weight:700;font-size:15px}
input,select{font:400 16px var(--body);padding:12px;border-radius:6px;border:2px solid var(--line);background:var(--panel);color:var(--ink)}
.results{grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr))}
.ba{margin:0;display:grid;grid-template-columns:1fr 1fr;gap:6px}
.ba div{position:relative;overflow:hidden;border-radius:8px;background:var(--panel)}
.ba img{display:block;width:100%;height:auto;aspect-ratio:3/4;object-fit:cover}
.ba span{position:absolute;inset-inline-start:8px;bottom:8px;background:var(--gold);color:var(--gold-ink);font:700 13px var(--body);padding:3px 10px;border-radius:4px}
footer{border-top:1px solid var(--line);padding:28px 0 40px;color:var(--muted);font-size:14px}
@media (max-width:640px){.card{padding:22px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}

/* brand: achrafahmadi.com */
body{background:var(--bg);font-weight:400}
.btn{border-radius:12px;font-weight:800}
.btn.wa{background:#25D366;color:#000}
.btn.wa:hover{background:#20ba59;filter:none}
.card,.ruler{border-radius:14px}
.toggle button{border-radius:10px}
.hero{position:relative;text-align:center;overflow:hidden;padding:56px 0 30px}
.hero::after{content:'';position:absolute;top:-120px;left:50%;transform:translateX(-50%);width:700px;max-width:100%;height:500px;background:radial-gradient(ellipse at 50% 30%,rgba(201,168,76,.12) 0%,transparent 65%);pointer-events:none;z-index:0}
.hero>*{position:relative;z-index:1}
.hero .lead{margin-inline:auto}
.hero .cta{justify-content:center}
.eyebrow{display:inline-flex;align-items:center;gap:10px;color:var(--gold);font-weight:600;font-size:14px;letter-spacing:0;margin-bottom:24px}
.eyebrow::before,.eyebrow::after{content:'';width:28px;height:1px;background:var(--gold);opacity:.6}
h1 em{font-style:normal;color:var(--gold);position:relative;display:inline-block}
h1 em::after{content:'';position:absolute;bottom:2px;inset-inline:0;height:2px;background:linear-gradient(to var(--end),var(--gold),transparent)}
.hero .ruler{text-align:start}
.hero-phone{direction:ltr;color:var(--muted);font-size:14px;margin:16px 0 0}
.hero-divider{display:flex;align-items:center;gap:16px;max-width:180px;margin:32px auto 0}
.hero-divider i{flex:1;height:1px;background:var(--line)}
.hero-divider b{width:5px;height:5px;background:var(--gold);transform:rotate(45deg);opacity:.7}
.card.sel{background:rgba(201,168,76,.05)}
.wa-float{position:fixed;bottom:24px;inset-inline-start:24px;z-index:50;width:56px;height:56px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(37,211,102,.35);transition:transform .2s}
.wa-float:hover{transform:scale(1.08)}
@media (max-width:640px){.wa-float{bottom:20px;inset-inline-start:16px}.hero{padding-top:36px}}

.results,.ba{direction:ltr}
:root{--end:left}
html[dir="ltr"]{--end:right}
html[dir="ltr"] .eyebrow{letter-spacing:3px}
html[dir="ltr"] h1{line-height:1.08}
.lang{display:flex;gap:4px;margin-inline-start:16px}
.lang button{font:700 13px var(--body);padding:6px 10px;border-radius:8px;border:1px solid var(--line);background:transparent;color:var(--muted);cursor:pointer}
.lang button[aria-pressed="true"]{background:var(--gold);color:var(--gold-ink);border-color:var(--gold)}
.hbar{display:flex;align-items:center}
@media (max-width:640px){.lang{margin-inline-start:8px}nav{display:none}.brand{font-size:19px}}
</style>
</head>
